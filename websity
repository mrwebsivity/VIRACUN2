            { q: "Seorang pekerja menyelesaikan pekerjaan dalam 6 hari. Berapa hari jika dikerjakan 3 orang?", opts: ["2 Hari", "3 Hari", "4 Hari", "1 Hari", "5 Hari"], correct: 0, exp: "Perbandingan berbalik nilai: 6 / 3 = 2 hari." },
            { q: "Deret Angka: 5, 10, 15, 20, ... berapakah suku ke-10?", opts: ["50", "45", "55", "60", "40"], correct: 0, exp: "Suku ke-n = 5 x n. Suku ke-10 = 5 x 10 = 50." },
            { q: "Analogi Kata: KUDA : RINGKIK = ANJING : ...", opts: ["GONGGONG", "AUNG", "CIT", "MEOONG", "KOKOK"], correct: 0, exp: "Suara khas kuda adalah meringkik, sedangkan anjing menggonggong." },
            { q: "Jika A > B dan B > C, manakah hubungan yang benar?", opts: ["A > C", "A < C", "A = C", "A + B = C", "Tidak dapat ditentukan"], correct: 0, exp: "Berdasarkan prinsip transitif: Jika A > B dan B > C maka A > C." },
            { q: "Hasil dari 15% dari 200 adalah...", opts: ["30", "20", "25", "35", "40"], correct: 0, exp: "15/100 x 200 = 30." },
            { q: "Jika x = 3 dan y = 4, berapakah √(x² + y²)?", opts: ["5", "6", "7", "8", "9"], correct: 0, exp: "√(9 + 16) = √25 = 5." },
            { q: "Deret Huruf: A, C, E, G, ... huruf berikutnya adalah...", opts: ["I", "H", "J", "K", "L"], correct: 0, exp: "Lompat 1 huruf: A (b) C (d) E (f) G (h) I." },
            { q: "Rata-rata dari nilai 70, 80, dan 90 adalah...", opts: ["80", "75", "85", "78", "82"], correct: 0, exp: "(70 + 80 + 90) / 3 = 240 / 3 = 80." },
            { q: "Analogi Kata: PENA : MENULIS = PISAU : ...", opts: ["MEMOTONG", "MENGUKIR", "MENUSUK", "MENGASAH", "MELEMPAR"], correct: 0, exp: "Fungsi utama pena untuk menulis, pisau untuk memotong." },
            { q: "Sebuah bus melaju 60 km/jam selama 2 jam. Jarak yang ditempuh adalah...", opts: ["120 km", "100 km", "90 km", "80 km", "150 km"], correct: 0, exp: "Jarak = Kecepatan x Waktu = 60 x 2 = 120 km." },
            { q: "Nilai dari 2³ + 3² adalah...", opts: ["17", "15", "18", "16", "20"], correct: 0, exp: "8 + 9 = 17." }
        ];

        for (let i = 16; i <= 30; i++) {
            const data = tiuQuestionsData[i - 16];
            cpnsQuestions.push({
                id: i,
                category: 'TIU',
                question: `${data.q} (Soal TIU #${i})`,
                options: data.opts,
                correct: data.correct,
                scoreType: 'STANDARD',
                explanation: `Pembahasan TIU Soal #${i}: ${data.exp}`
            });
        }

        // 20 TKP Questions (Score 1-5)
        for (let i = 31; i <= 50; i++) {
            cpnsQuestions.push({
                id: i,
                category: 'TKP',
                question: `Ketika Anda dihadapkan pada situasi perubahan teknologi baru di kantor yang belum Anda kuasai, sikap Anda adalah... (Soal TKP #${i})`,
                options: [
                    'Antusias mempelajari teknologi baru dan mengajak rekan kerja beradaptasi (Skor 5)',
                    'Mempelajari teknologi baru jika diwajibkan oleh atasan (Skor 4)',
                    'Meminta rekan kerja lain yang lebih paham untuk mengerjakan tugas Anda (Skor 3)',
                    'Menggunakan cara lama yang sudah biasa Anda gunakan (Skor 2)',
                    'Mengeluh karena teknologi baru menyulitkan kerja (Skor 1)'
                ],
                correct: 0, // Best answer for index 0
                scoreType: 'TKP', // Score scale 1 to 5
                explanation: `Pembahasan TKP Soal #${i}: Opsi A memiliki skor tertinggi (5) karena menunjukkan indikator adaptasi teknologi & kepemimpinan positif.`
            });
        }

        // STATE SIMULASI
        let userAnswers = new Array(50).fill(null); // Array simpan jawaban (0-4)
        let userDoubt = new Array(50).fill(false);   // Array simpan ragu-ragu (boolean)
        let currentQIndex = 0;
        let timerInterval = null;

        function startTryoutEngine() {
            userAnswers.fill(null);
            userDoubt.fill(false);
            currentQIndex = 0;
            document.getElementById('tryout-simulation-container').classList.remove('hidden');
            renderQuestionGrid();
            loadQuestion(0);
            startTimer(90 * 60); // 90 menit
        }

        function renderQuestionGrid() {
            const gridContainer = document.getElementById('question-grid');
            gridContainer.innerHTML = '';

            for (let i = 0; i < 50; i++) {
                const btn = document.createElement('button');
                btn.className = getGridBtnClass(i);
                btn.innerText = i + 1;
                btn.onclick = () => jumpToQuestion(i);
                gridContainer.appendChild(btn);
            }
        }

        function getGridBtnClass(idx) {
            let base = "w-8 h-8 rounded-lg font-bold text-xs flex items-center justify-center transition border shadow-sm ";
            if(idx === currentQIndex) {
                base += "ring-2 ring-viracun-600 ring-offset-1 ";
            }
            if(userDoubt[idx]) {
                base += "bg-amber-400 text-white border-amber-500";
            } else if(userAnswers[idx] !== null) {
                base += "bg-viracun-600 text-white border-viracun-700";
            } else {
                base += "bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200";
            }
            return base;
        }

        function loadQuestion(idx) {
            currentQIndex = idx;
            const q = cpnsQuestions[idx];

            document.getElementById('question-number-text').innerText = `Soal No. ${idx + 1} dari 50`;
            document.getElementById('question-category').innerText = q.category;
            document.getElementById('question-text').innerText = q.question;
            document.getElementById('chk-doubt').checked = userDoubt[idx];

            const optsContainer = document.getElementById('options-container');
            optsContainer.innerHTML = '';

            q.options.forEach((opt, optIdx) => {
                const isSelected = userAnswers[idx] === optIdx;
                const btn = document.createElement('button');
                btn.className = `w-full text-left p-3.5 sm:p-4 rounded-xl border text-xs sm:text-sm font-medium transition flex items-center gap-3 ${
                    isSelected 
                    ? 'border-viracun-600 bg-pink-50 text-viracun-900 font-bold ring-1 ring-viracun-500' 
                    : 'border-slate-200 hover:border-viracun-300 hover:bg-slate-50 text-slate-700'
                }`;

                btn.innerHTML = `
                    <span class="w-6 h-6 rounded-lg ${isSelected ? 'bg-viracun-600 text-white' : 'bg-slate-100 text-slate-600'} flex items-center justify-center text-xs font-bold shrink-0">
                        ${String.fromCharCode(65 + optIdx)}
                    </span>
                    <span>${opt}</span>
                `;
                btn.onclick = () => selectOption(optIdx);
                optsContainer.appendChild(btn);
            });

            // Prev button state
            document.getElementById('btn-prev').disabled = idx === 0;

            renderQuestionGrid();
        }

        function selectOption(optIdx) {
            userAnswers[currentQIndex] = optIdx;
            renderQuestionGrid();
            loadQuestion(currentQIndex);
        }

        function toggleDoubt() {
            userDoubt[currentQIndex] = document.getElementById('chk-doubt').checked;
            renderQuestionGrid();
        }

        function nextQuestion() {
            if(currentQIndex < 49) {
                loadQuestion(currentQIndex + 1);
            }
        }

        function prevQuestion() {
            if(currentQIndex > 0) {
                loadQuestion(currentQIndex - 1);
            }
        }

        function jumpToQuestion(idx) {
            loadQuestion(idx);
        }

        function startTimer(seconds) {
            let timer = seconds;
            const display = document.getElementById('sim-timer');
            clearInterval(timerInterval);

            timerInterval = setInterval(() => {
                const minutes = Math.floor(timer / 60);
                const secs = timer % 60;
                display.innerText = `${minutes < 10 ? '0' : ''}${minutes}:${secs < 10 ? '0' : ''}${secs}`;

                if (--timer < 0) {
                    clearInterval(timerInterval);
                    finishTryout();
                }
            }, 1000);
        }

        function confirmFinishTryout() {
            const unanswered = userAnswers.filter(a => a === null).length;
            let msg = "Apakah Anda yakin ingin mengakhiri dan mengirimkan simulasi Try Out?";
            if(unanswered > 0) {
                msg = `Masih ada ${unanswered} soal yang BELUM dijawab! Yakin ingin menyelesaikan sekarang?`;
            }
            if(confirm(msg)) {
                finishTryout();
            }
        }

        function finishTryout() {
            clearInterval(timerInterval);
            document.getElementById('tryout-simulation-container').classList.add('hidden');

            // CALCULATE SCORES
            let scoreTWK = 0; // 15 Soal x 5 = Max 75
            let scoreTIU = 0; // 15 Soal x 5 = Max 75
            let scoreTKP = 0; // 20 Soal x 5 = Max 100

            cpnsQuestions.forEach((q, idx) => {
                const ans = userAnswers[idx];
                if(q.scoreType === 'STANDARD') {
                    if(ans === q.correct) {
                        if(q.category === 'TWK') scoreTWK += 5;
                        if(q.category === 'TIU') scoreTIU += 5;
                    }
                } else if(q.scoreType === 'TKP') {
                    if(ans !== null) {
                        // TKP Scoring: 5, 4, 3, 2, 1 based on option
                        scoreTKP += (5 - ans);
                    }
                }
            });

            // Convert to Standard CPNS Scaling (Scaled up to 500 max)
            const scaledTWK = Math.round(scoreTWK * (150 / 75));  // Max 150
            const scaledTIU = Math.round(scoreTIU * (175 / 75));  // Max 175
            const scaledTKP = Math.round(scoreTKP * (175 / 100)); // Max 175
            const totalScore = scaledTWK + scaledTIU + scaledTKP;

            // Display Results in Modal
            document.getElementById('res-total-score').innerText = totalScore;
            document.getElementById('res-twk-score').innerText = `${scaledTWK} / 150`;
            document.getElementById('res-tiu-score').innerText = `${scaledTIU} / 175`;
            document.getElementById('res-tkp-score').innerText = `${scaledTKP} / 175`;

            // Passing Grade CPNS Checks (PG: TWK 65, TIU 80, TKP 166)
            const passTWK = scaledTWK >= 65;
            const passTIU = scaledTIU >= 80;
            const passTKP = scaledTKP >= 166;

            document.getElementById('res-twk-status').innerHTML = passTWK ? '<span class="text-emerald-600">✓ Pass PG (65)</span>' : '<span class="text-red-500">✗ Tidak PG</span>';
            document.getElementById('res-tiu-status').innerHTML = passTIU ? '<span class="text-emerald-600">✓ Pass PG (80)</span>' : '<span class="text-red-500">✗ Tidak PG</span>';
            document.getElementById('res-tkp-status').innerHTML = passTKP ? '<span class="text-emerald-600">✓ Pass PG (166)</span>' : '<span class="text-red-500">✗ Tidak PG</span>';

            const passBanner = document.getElementById('res-pass-banner');
            if(passTWK && passTIU && passTKP) {
                passBanner.className = 'p-4 rounded-2xl font-bold text-center text-sm bg-emerald-100 text-emerald-800 border border-emerald-300';
                passBanner.innerHTML = '🎉 SELAMAT! Anda Dinyatakan MEMENUHI PASSING GRADE (LOLOS SKD CPNS 2026)';
            } else {
                passBanner.className = 'p-4 rounded-2xl font-bold text-center text-sm bg-amber-100 text-amber-800 border border-amber-300';
                passBanner.innerHTML = '⚠️ HASIL: Belum Memenuhi Passing Grade CPNS. Pelajari Kembali Pembahasan Detail 50 Soal Di Bawah Ini!';
            }

            // RENDER ALL 50 QUESTIONS DISCUSSION LIST
            const listContainer = document.getElementById('discussion-list-container');
            listContainer.innerHTML = '';

            cpnsQuestions.forEach((q, idx) => {
                const uAns = userAnswers[idx];
                const isCorrect = uAns === q.correct;
                
                const item = document.createElement('div');
                item.className = 'p-4 rounded-2xl border text-xs sm:text-sm space-y-3 ' + (isCorrect ? 'bg-slate-50 border-slate-200' : 'bg-red-50/40 border-red-200');
                
                item.innerHTML = `
                    <div class="flex items-center justify-between border-b border-slate-200 pb-2">
                        <span class="font-black text-slate-800">Soal #${idx + 1} (${q.category})</span>
                        <span class="font-bold px-2.5 py-0.5 rounded-full text-[10px] ${uAns !== null ? 'bg-slate-200 text-slate-700' : 'bg-amber-100 text-amber-700'}">
                            ${uAns !== null ? 'Jawaban Anda: Opsi ' + String.fromCharCode(65 + uAns) : 'Tidak Dijawab'}
                        </span>
                    </div>
                    <p class="font-medium text-slate-800">${q.question}</p>
                    <div class="bg-white p-3 rounded-xl border border-slate-100 space-y-1">
                        <p class="font-bold text-viracun-600 text-xs">Kunci Jawaban: Opsi ${String.fromCharCode(65 + q.correct)}</p>
                        <p class="text-xs text-slate-600 mt-1">${q.explanation}</p>
                    </div>
                `;
                listContainer.appendChild(item);
            });

            document.getElementById('result-modal').classList.remove('hidden');
        }

        function closeResultModal() {
            document.getElementById('result-modal').classList.add('hidden');
        }

        window.onload = function() {
            switchTab('dashboard');
        };
    </script>
</body>
</html>
